{
  "name": "shp-write",
  "version": "0.4.0",
  "description": "write shapefiles from pure javascript",
  "type": "module",
  "license": "BSD-2-Clause",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/mapbox/shp-write.git"
  },
  "keywords": [
    "shapefile",
    "write",
    "js",
    "typescript"
  ],
  "author": "Tom MacWright",
  "contributors": [
    {
      "name": "Nick Baugh",
      "email": "niftylettuce@gmail.com"
    }
  ],
  "bugs": {
    "url": "https://github.com/mapbox/shp-write/issues"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3",
    "unplugin-dts": "^1.1.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.4"
  }
}
